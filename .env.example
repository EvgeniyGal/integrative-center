# Database (Neon)
DATABASE_URL=

# NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# First admin (used by npm run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Resend (invites + password reset)
RESEND_API_KEY=
EMAIL_FROM="HBI Admin <onboarding@resend.dev>"

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (contact form)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Local always-pass test keys: site 1x0000000000000000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console (optional meta verification)
GOOGLE_SITE_VERIFICATION=
